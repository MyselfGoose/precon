# Public site URL (used for metadataBase / canonical / OG absolute URLs)
NEXT_PUBLIC_SITE_URL=https://csianddesign.com

# Lead delivery (server-only — never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=
LEAD_TO_EMAIL=hello@csianddesign.com
# Must be a verified sender/domain in Resend (e.g. CSI & Design <hello@csianddesign.com>).
# Do not use onboarding@resend.dev in production — Resend restricts sandbox delivery.
LEAD_FROM_EMAIL=CSI & Design <hello@csianddesign.com>
