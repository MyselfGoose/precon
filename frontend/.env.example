# Public site URL (used for metadataBase / canonical / OG absolute URLs)
NEXT_PUBLIC_SITE_URL=https://quantsult.com

# staging = disallow all in robots + noindex metadata
# NEXT_PUBLIC_SITE_ENV=staging

# Lead delivery (server-only — never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=
LEAD_TO_EMAIL=hello@quantsult.com
# Must be a verified sender/domain in Resend (e.g. QuantSult <hello@quantsult.com>).
# Do not use onboarding@resend.dev in production — Resend restricts sandbox delivery.
LEAD_FROM_EMAIL=QuantSult <hello@quantsult.com>

# Optional: Vercel Blob for direct plan uploads up to 100 MB (server-only)
# BLOB_READ_WRITE_TOKEN=
